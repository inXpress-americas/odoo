<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Freight class sits next to the HS code: both describe the goods for a
         carrier rather than for Odoo, and both are already looked for here -->
    <record id="view_product_template_form_inxpress" model="ir.ui.view">
        <field name="name">product.template.form.inxpress</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="stock_delivery.product_template_hs_code"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='hs_code']" position="after">
                <field name="inxpress_freight_class"/>
            </xpath>
        </field>
    </record>

</odoo>
